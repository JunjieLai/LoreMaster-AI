# ============================================
# LoreMaster-AI Environment Configuration
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# --------------------------------------------
# AWS Configuration
# --------------------------------------------
AWS_REGION=us-east-1
S3_BUCKET=loremaster-ai-你的netid

# --------------------------------------------
# DynamoDB Tables
# --------------------------------------------
DYNAMODB_ENTITY_TABLE=loremaster-entity-metadata
DYNAMODB_VERSION_TABLE=loremaster-data-versions
DYNAMODB_ALIAS_TABLE=loremaster-alias-mapping

# --------------------------------------------
# Neo4j AuraDB Configuration
# Get these from: https://console.neo4j.io/
# --------------------------------------------
NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=

# --------------------------------------------
# Pinecone Configuration
# Get these from: https://app.pinecone.io/
# --------------------------------------------
PINECONE_API_KEY=
PINECONE_INDEX=loremaster-index
PINECONE_HOST=

# --------------------------------------------
# HuggingFace Configuration
# Get token from: https://huggingface.co/settings/tokens
# --------------------------------------------
HF_TOKEN=

# --------------------------------------------
# Anthropic Configuration
# Get key from: https://console.anthropic.com/
# --------------------------------------------
ANTHROPIC_API_KEY=
